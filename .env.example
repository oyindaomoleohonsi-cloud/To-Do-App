# Environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local   (macOS/Linux)
#   copy .env.example .env.local   (Windows)
#
# `.env.local` is ignored by git. Never commit real secrets.
#
# ---------------------------------------------------------------------------
# Required: none.
#
# Tasks are currently stored in memory (see lib/repository.ts), so the app
# needs no configuration to run.
#
# When a real database or an external service is added, add its variables here
# with placeholder values only, for example:
#
#   # Connection string for the production database.
#   DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB_NAME"
#
# Secrets must be read from process.env in lib/, never hard-coded in the app.
# ---------------------------------------------------------------------------
